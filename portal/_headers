# Cache control for the Neon Giant referral portal
# Static HTML pages — short cache, must revalidate so dashboard stays fresh
/portal.html
  Cache-Control: public, max-age=60, must-revalidate
/refer.html
  Cache-Control: public, max-age=60, must-revalidate
/index.html
  Cache-Control: public, max-age=300

# API responses never cache
/api/*
  Cache-Control: no-store, no-cache, must-revalidate
  X-Robots-Tag: noindex

# Logo + static assets — long cache, content-addressed
/logo.jpg
  Cache-Control: public, max-age=86400

# Security headers everywhere
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=()
